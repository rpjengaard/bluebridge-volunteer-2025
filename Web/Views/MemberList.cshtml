@model Web.ViewModels.MemberListViewModel
@using Umbraco.Cms.Core.Security
@inject IMemberManager MemberManager
@{
    Layout = null;
    var currentMember = await MemberManager.GetCurrentMemberAsync();
}
<!DOCTYPE html>
<html lang="da" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frivilligliste - Blue Bridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; }
        h1, h2, h3 { font-family: 'Playfair Display', serif; }
        .bg-blue-bridge { background-color: #23297A; }
        .text-blue-bridge { color: #23297A; }
        .bg-accent-yellow { background-color: #FFF000; }
        .border-blue-bridge { border-color: #23297A; }
    </style>
</head>
<body class="h-full">

    @await Html.PartialAsync("Partials/_Navigation")

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-8">
            <div class="flex flex-wrap items-start gap-3 justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Frivilligliste</h1>
                    <p class="mt-2 text-gray-600">Alle frivillige for Blue Bridge Festival 2026.</p>
                </div>
                <div class="flex items-center gap-2">
                    <span id="memberCount" class="flex items-center bg-blue-bridge text-white text-sm px-4 py-2 rounded-full font-medium">
                        @Model.Members.Count frivillige
                    </span>
                    @if (Model.IsAdmin)
                    {
                        <button id="openEmailModal" type="button"
                            class="flex items-center gap-2 bg-blue-bridge text-white text-sm px-4 py-2 rounded-full font-medium hover:opacity-90 transition-opacity">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                            </svg>
                            Send email (<span id="emailRecipientCount">@Model.Members.Count</span>)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Search and filter controls -->
        <div class="bg-white shadow rounded-lg p-4 mb-6">
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1 relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                        </svg>
                    </div>
                    <input
                        type="search"
                        id="searchInput"
                        placeholder="Søg på navn eller e-mail..."
                        class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent"
                    >
                </div>
                <div class="sm:w-52">
                    <select
                        id="crewFilter"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent bg-white"
                    >
                        <option value="">Alle crews</option>
                        @foreach (var crew in Model.AllCrews)
                        {
                            <option value="@crew">@crew</option>
                        }
                        <option value="__none_crew__">Ingen crew tildelt</option>
                    </select>
                </div>
                <div class="sm:w-52">
                    <select
                        id="groupFilter"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent bg-white"
                    >
                        <option value="">Alle grupper</option>
                        @foreach (var group in Model.AllGroups)
                        {
                            <option value="@group">@group</option>
                        }
                        <option value="__none_group__">Ingen gruppe</option>
                    </select>
                </div>
                <div class="sm:w-48">
                    <select
                        id="sortSelect"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent bg-white"
                    >
                        <option value="name">Sorter: Navn A-Z</option>
                        <option value="name-desc">Sorter: Navn Z-A</option>
                        <option value="date-desc">Sorter: Sidst tilmeldt</option>
                        <option value="date-asc">Sorter: Først tilmeldt</option>
                    </select>
                </div>
                <button
                    id="resetBtn"
                    type="button"
                    class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors whitespace-nowrap"
                >
                    Nulstil
                </button>
            </div>
        </div>

        <!-- Member list -->
        <div id="memberList" class="space-y-3">
            @foreach (var member in Model.Members.OrderBy(m => m.FullName))
            {
                var crewDataAttr = member.Crews.Any()
                    ? string.Join("|", member.Crews).ToLowerInvariant()
                    : "";
                var groupDataAttr = member.Groups.Any()
                    ? string.Join("|", member.Groups).ToLowerInvariant()
                    : "";
                <a
                    href="/member?key=@member.MemberKey"
                    class="member-card block bg-white shadow rounded-lg p-4 hover:bg-gray-50 transition-colors @(!member.Crews.Any() ? "opacity-50 grayscale" : "")"
                    data-name="@member.FullName.ToLowerInvariant()"
                    data-email="@member.Email.ToLowerInvariant()"
                    data-crews="@crewDataAttr"
                    data-has-crew="@(member.Crews.Any() ? "1" : "0")"
                    data-groups="@groupDataAttr"
                    data-has-group="@(member.Groups.Any() ? "1" : "0")"
                    data-date="@member.SignupDate.ToString("yyyy-MM-dd")"
                >
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded-lg bg-blue-bridge flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                            @(member.FullName.Length > 0 ? member.FullName[0].ToString().ToUpper() : "?")
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-900 truncate">@member.FullName</div>
                            <div class="text-sm text-gray-500 truncate">@member.Email</div>
                            @if (member.Crews.Any() || member.Groups.Any())
                            {
                                <div class="flex flex-wrap gap-1 mt-1">
                                    @foreach (var crew in member.Crews)
                                    {
                                        <span class="inline-block text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded">@crew</span>
                                    }
                                    @foreach (var group in member.Groups)
                                    {
                                        var badgeColor = group.ToLowerInvariant() switch
                                        {
                                            "admin" => "bg-red-100 text-red-800",
                                            "vagtplanlæggere" => "bg-purple-100 text-purple-800",
                                            _ => "bg-green-100 text-green-800"
                                        };
                                        <span class="inline-block text-xs @badgeColor px-2 py-0.5 rounded">@group</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="text-xs text-gray-400 flex-shrink-0 hidden sm:block">
                            @member.SignupDate.ToString("dd.MM.yyyy")
                        </div>
                        <svg class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </div>
                </a>
            }
        </div>

        <!-- Empty state -->
        <div id="noResults" class="hidden bg-white shadow rounded-lg p-12 text-center">
            <svg class="mx-auto h-10 w-10 text-gray-300 mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <p class="text-sm text-gray-500">Ingen frivillige matcher søgningen.</p>
        </div>

    </main>

    @await Html.PartialAsync("Partials/_Footer")

    @if (Model.IsAdmin)
    {
        <!-- Hidden antiforgery form for AJAX -->
        <form id="antiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

        <!-- Email compose modal -->
        <div id="emailModal" class="fixed inset-0 z-50 hidden">
            <div id="emailModalBackdrop" class="absolute inset-0 bg-black/60"></div>
            <div class="relative flex items-center justify-center h-full p-4">
                <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-2xl flex flex-col" style="max-height:90vh;">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-bold text-gray-900">Send email til <span id="emailModalCount">0</span> modtagere</h2>
                        <button id="emailModalClose" type="button"
                            class="flex items-center justify-center w-9 h-9 rounded-full bg-white shadow-md text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors"
                            aria-label="Luk">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <div class="px-6 py-4 overflow-y-auto flex-1 space-y-4">
                        <div>
                            <label for="emailSubject" class="block text-sm font-medium text-gray-700 mb-1">Emne</label>
                            <input id="emailSubject" type="text" placeholder="Emne..."
                                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent" />
                        </div>
                        <div>
                            <label for="emailBody" class="block text-sm font-medium text-gray-700 mb-1">Besked (HTML)</label>
                            <textarea id="emailBody" rows="10" placeholder="Skriv din besked her..."
                                class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent font-mono"></textarea>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 mb-2">Klik på en variabel for at indsætte den ved markørens position:</p>
                            <div class="flex flex-wrap gap-2" id="variableChips">
                                @foreach (var variable in new[] { "firstName", "lastName", "email", "phone", "currentCrews", "portalUrl", "invitationUrl" })
                                {
                                    <button type="button"
                                        class="variable-chip text-xs bg-blue-50 text-blue-700 border border-blue-200 px-2 py-1 rounded hover:bg-blue-100 transition-colors font-mono"
                                        data-variable="{{ @variable }}">
                                        {{ @variable }}
                                    </button>
                                }
                            </div>
                        </div>
                        <div id="emailStatus" class="hidden"></div>
                    </div>
                    <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
                        <button id="emailCancelBtn" type="button"
                            class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors">
                            Annuller
                        </button>
                        <button id="emailSendBtn" type="button"
                            class="flex items-center gap-2 px-4 py-2 text-sm bg-blue-bridge text-white rounded-md hover:opacity-90 transition-opacity disabled:opacity-50">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                            </svg>
                            Send
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Member detail modal -->
    <div id="memberModal" class="fixed inset-0 z-50 hidden">
        <div id="modalBackdrop" class="absolute inset-0 bg-black/60"></div>
        <div class="relative flex items-center justify-center h-full p-4">
            <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-5xl h-[90vh] flex flex-col">
                <button
                    id="modalClose"
                    type="button"
                    class="absolute top-3 right-3 z-10 flex items-center justify-center w-9 h-9 rounded-full bg-white shadow-md text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors"
                    aria-label="Luk"
                >
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
                <iframe id="modalFrame" src="" class="w-full flex-1 rounded-xl border-0" title="Medlemsprofil"></iframe>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const searchInput = document.getElementById('searchInput');
            const crewFilter = document.getElementById('crewFilter');
            const groupFilter = document.getElementById('groupFilter');
            const sortSelect = document.getElementById('sortSelect');
            const resetBtn = document.getElementById('resetBtn');
            const memberList = document.getElementById('memberList');
            const noResults = document.getElementById('noResults');
            const memberCountBadge = document.getElementById('memberCount');
            const emailRecipientCount = document.getElementById('emailRecipientCount');

            const cards = Array.from(memberList.querySelectorAll('.member-card'));

            function applyFilters() {
                const search = searchInput.value.toLowerCase().trim();
                const crew = crewFilter.value;
                const group = groupFilter.value;

                let visibleCount = 0;

                cards.forEach(function (card) {
                    const name = card.dataset.name || '';
                    const email = card.dataset.email || '';
                    const crews = card.dataset.crews || '';
                    const hasCrew = card.dataset.hasCrew === '1';
                    const groups = card.dataset.groups || '';
                    const hasGroup = card.dataset.hasGroup === '1';

                    const matchesSearch = !search || name.includes(search) || email.includes(search);

                    let matchesCrew;
                    if (!crew) {
                        matchesCrew = true;
                    } else if (crew === '__none_crew__') {
                        matchesCrew = !hasCrew;
                    } else {
                        matchesCrew = crews.split('|').some(function (c) {
                            return c.trim() === crew.toLowerCase();
                        });
                    }

                    let matchesGroup;
                    if (!group) {
                        matchesGroup = true;
                    } else if (group === '__none_group__') {
                        matchesGroup = !hasGroup;
                    } else {
                        matchesGroup = groups.split('|').some(function (g) {
                            return g.trim() === group.toLowerCase();
                        });
                    }

                    const visible = matchesSearch && matchesCrew && matchesGroup;
                    card.style.display = visible ? '' : 'none';
                    if (visible) visibleCount++;
                });

                noResults.classList.toggle('hidden', visibleCount > 0);
                memberList.classList.toggle('hidden', visibleCount === 0);
                memberCountBadge.textContent = visibleCount + ' frivillige';
                if (emailRecipientCount) emailRecipientCount.textContent = visibleCount;

                applySort();
            }

            function applySort() {
                const sort = sortSelect.value;
                const sorted = Array.from(memberList.querySelectorAll('.member-card')).sort(function (a, b) {
                    if (sort === 'name') return a.dataset.name.localeCompare(b.dataset.name, 'da');
                    if (sort === 'name-desc') return b.dataset.name.localeCompare(a.dataset.name, 'da');
                    if (sort === 'date-desc') return b.dataset.date.localeCompare(a.dataset.date);
                    if (sort === 'date-asc') return a.dataset.date.localeCompare(b.dataset.date);
                    return 0;
                });
                sorted.forEach(function (card) { memberList.appendChild(card); });
            }

            searchInput.addEventListener('input', applyFilters);
            crewFilter.addEventListener('change', applyFilters);
            groupFilter.addEventListener('change', applyFilters);
            sortSelect.addEventListener('change', applySort);

            resetBtn.addEventListener('click', function () {
                searchInput.value = '';
                crewFilter.value = '';
                groupFilter.value = '';
                sortSelect.value = 'name';
                applyFilters();
                searchInput.focus();
            });

            // Member detail modal
            const modal = document.getElementById('memberModal');
            const modalFrame = document.getElementById('modalFrame');
            const modalClose = document.getElementById('modalClose');
            const modalBackdrop = document.getElementById('modalBackdrop');

            function openModal(url) {
                modalFrame.src = url;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                modal.classList.add('hidden');
                modalFrame.src = '';
                document.body.style.overflow = '';
            }

            memberList.addEventListener('click', function (e) {
                const card = e.target.closest('.member-card');
                if (!card) return;
                e.preventDefault();
                openModal(card.href + '&embed=1');
            });

            modalClose.addEventListener('click', closeModal);
            modalBackdrop.addEventListener('click', closeModal);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeModal();
                    closeEmailModal();
                }
            });

            // Email modal
            const openEmailModalBtn = document.getElementById('openEmailModal');
            const emailModal = document.getElementById('emailModal');
            if (openEmailModalBtn && emailModal) {
                const emailModalBackdrop = document.getElementById('emailModalBackdrop');
                const emailModalClose = document.getElementById('emailModalClose');
                const emailCancelBtn = document.getElementById('emailCancelBtn');
                const emailSendBtn = document.getElementById('emailSendBtn');
                const emailSubject = document.getElementById('emailSubject');
                const emailBody = document.getElementById('emailBody');
                const emailModalCount = document.getElementById('emailModalCount');
                const emailStatus = document.getElementById('emailStatus');

                function getVisibleEmails() {
                    return Array.from(memberList.querySelectorAll('.member-card'))
                        .filter(function (c) { return c.style.display !== 'none'; })
                        .map(function (c) { return c.dataset.email; })
                        .filter(Boolean);
                }

                function openEmailModal() {
                    const count = getVisibleEmails().length;
                    emailModalCount.textContent = count;
                    emailStatus.classList.add('hidden');
                    emailStatus.textContent = '';
                    emailModal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                    emailSubject.focus();
                }

                function closeEmailModal() {
                    if (!emailModal) return;
                    emailModal.classList.add('hidden');
                    document.body.style.overflow = '';
                }

                function getAntiForgeryToken() {
                    const form = document.getElementById('antiForgeryForm');
                    if (!form) return '';
                    const input = form.querySelector('input[name="__RequestVerificationToken"]');
                    return input ? input.value : '';
                }

                openEmailModalBtn.addEventListener('click', openEmailModal);
                emailModalClose.addEventListener('click', closeEmailModal);
                emailModalBackdrop.addEventListener('click', closeEmailModal);
                emailCancelBtn.addEventListener('click', closeEmailModal);

                // Variable chips — insert at cursor
                document.getElementById('variableChips').addEventListener('click', function (e) {
                    const chip = e.target.closest('.variable-chip');
                    if (!chip) return;
                    const variable = chip.dataset.variable;
                    const start = emailBody.selectionStart;
                    const end = emailBody.selectionEnd;
                    const value = emailBody.value;
                    emailBody.value = value.slice(0, start) + variable + value.slice(end);
                    emailBody.selectionStart = emailBody.selectionEnd = start + variable.length;
                    emailBody.focus();
                });

                emailSendBtn.addEventListener('click', async function () {
                    const subject = emailSubject.value.trim();
                    const body = emailBody.value.trim();
                    const emails = getVisibleEmails();

                    if (!subject || !body) {
                        emailStatus.className = 'p-3 rounded bg-red-50 text-red-700 text-sm';
                        emailStatus.textContent = 'Udfyld både emne og besked.';
                        emailStatus.classList.remove('hidden');
                        return;
                    }
                    if (emails.length === 0) {
                        emailStatus.className = 'p-3 rounded bg-red-50 text-red-700 text-sm';
                        emailStatus.textContent = 'Ingen synlige modtagere.';
                        emailStatus.classList.remove('hidden');
                        return;
                    }

                    emailSendBtn.disabled = true;
                    emailSendBtn.textContent = 'Sender...';
                    emailStatus.classList.add('hidden');

                    try {
                        const response = await fetch('/umbraco/surface/MemberEmailSurface/SendBulk', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': getAntiForgeryToken()
                            },
                            body: JSON.stringify({ emails, subject, body })
                        });

                        const result = await response.json();

                        if (result.success) {
                            emailStatus.className = 'p-3 rounded bg-green-50 text-green-700 text-sm';
                            emailStatus.textContent = 'E-mail sendt til ' + result.sentCount + ' modtagere.';
                        } else {
                            let msg = 'Sendt til ' + result.sentCount + ' modtagere. ' + result.errorCount + ' fejl.';
                            if (result.errors && result.errors.length > 0) {
                                msg += '\n' + result.errors.slice(0, 5).join('\n');
                            }
                            emailStatus.className = 'p-3 rounded bg-yellow-50 text-yellow-800 text-sm whitespace-pre-line';
                            emailStatus.textContent = msg;
                        }
                        emailStatus.classList.remove('hidden');
                    } catch (err) {
                        emailStatus.className = 'p-3 rounded bg-red-50 text-red-700 text-sm';
                        emailStatus.textContent = 'Afsendelse mislykkedes: ' + err.message;
                        emailStatus.classList.remove('hidden');
                    } finally {
                        emailSendBtn.disabled = false;
                        emailSendBtn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" /></svg> Send';
                    }
                });
            }
        })();
    </script>
</body>
</html>