@model Web.ViewModels.MemberListViewModel
@using Umbraco.Cms.Core.Security
@inject IMemberManager MemberManager
@{
    Layout = null;
    var currentMember = await MemberManager.GetCurrentMemberAsync();
}
<!DOCTYPE html>
<html lang="da" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frivilligliste - Blue Bridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; }
        h1, h2, h3 { font-family: 'Playfair Display', serif; }
        .bg-blue-bridge { background-color: #23297A; }
        .text-blue-bridge { color: #23297A; }
        .bg-accent-yellow { background-color: #FFF000; }
        .border-blue-bridge { border-color: #23297A; }
        th[data-sort] { cursor: pointer; user-select: none; }
        th[data-sort]:hover { background-color: rgba(255,255,255,0.1); }
        th[data-sort].sort-asc::after { content: ' ↑'; opacity: 0.8; }
        th[data-sort].sort-desc::after { content: ' ↓'; opacity: 0.8; }
        th[data-sort]:not(.sort-asc):not(.sort-desc)::after { content: ' ↕'; opacity: 0.4; }
    </style>
</head>
<body class="h-full">
    <div class="min-h-screen">
        @await Html.PartialAsync("Partials/_Navigation")

        <!-- Header -->
        <header class="bg-blue-bridge text-white shadow-lg">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-2xl font-bold">Frivilligliste</h1>
                        <p class="text-white/70 text-sm">Alle frivillige</p>
                    </div>
                    <span id="memberCount" class="bg-white/20 text-white text-sm px-4 py-2 rounded-full font-medium">
                        @Model.Members.Count frivillige
                    </span>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

            <!-- Search and filter controls -->
            <div class="bg-white shadow rounded-lg p-4 mb-6">
                <div class="flex flex-col sm:flex-row gap-3">
                    <div class="flex-1 relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </div>
                        <input
                            type="search"
                            id="searchInput"
                            placeholder="Søg på navn eller e-mail..."
                            class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent"
                        >
                    </div>
                    <div class="sm:w-52">
                        <select
                            id="crewFilter"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent bg-white"
                        >
                            <option value="">Alle crews</option>
                            @foreach (var crew in Model.AllCrews)
                            {
                                <option value="@crew">@crew</option>
                            }
                            <option value="__none_crew__">Ingen crew tildelt</option>
                        </select>
                    </div>
                    <div class="sm:w-52">
                        <select
                            id="groupFilter"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-bridge focus:border-transparent bg-white"
                        >
                            <option value="">Alle grupper</option>
                            @foreach (var group in Model.AllGroups)
                            {
                                <option value="@group">@group</option>
                            }
                            <option value="__none_group__">Ingen gruppe</option>
                        </select>
                    </div>
                    <button
                        id="resetBtn"
                        type="button"
                        class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-md hover:bg-gray-50 transition-colors whitespace-nowrap"
                    >
                        Nulstil
                    </button>
                </div>
            </div>

            <!-- Member table -->
            <div class="bg-white shadow rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200" id="memberTable">
                        <thead class="bg-blue-bridge">
                            <tr>
                                <th
                                    data-sort="name"
                                    class="sort-asc px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider"
                                >
                                    Navn
                                </th>
                                <th
                                    data-sort="email"
                                    class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider"
                                >
                                    E-mail
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">
                                    Crew
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider">
                                    Gruppe(r)
                                </th>
                                <th
                                    data-sort="signup"
                                    class="px-6 py-3 text-left text-xs font-semibold text-white uppercase tracking-wider"
                                >
                                    Tilmeldt
                                </th>
                            </tr>
                        </thead>
                        <tbody id="memberTableBody" class="bg-white divide-y divide-gray-200">
                            @foreach (var member in Model.Members)
                            {
                                var crewDataAttr = member.Crews.Any()
                                    ? string.Join("|", member.Crews).ToLowerInvariant()
                                    : "";
                                var groupDataAttr = member.Groups.Any()
                                    ? string.Join("|", member.Groups).ToLowerInvariant()
                                    : "";
                                <tr
                                    class="hover:bg-slate-50 transition-colors"
                                    data-name="@member.FullName.ToLowerInvariant()"
                                    data-email="@member.Email.ToLowerInvariant()"
                                    data-crews="@crewDataAttr"
                                    data-has-crew="@(member.Crews.Any() ? "1" : "0")"
                                    data-groups="@groupDataAttr"
                                    data-has-group="@(member.Groups.Any() ? "1" : "0")"
                                    data-signup="@member.SignupDate.Ticks"
                                >
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <a
                                            href="/member?key=@member.MemberKey"
                                            class="text-sm font-medium text-blue-bridge hover:underline"
                                        >
                                            @member.FullName
                                        </a>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <a
                                            href="mailto:@member.Email"
                                            class="text-sm text-gray-600 hover:text-blue-bridge hover:underline"
                                        >
                                            @member.Email
                                        </a>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (member.Crews.Any())
                                        {
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var crew in member.Crews)
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                                        @crew
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-gray-400 italic">Ingen crew</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (member.Groups.Any())
                                        {
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var group in member.Groups)
                                                {
                                                    var badgeColor = group.ToLowerInvariant() switch
                                                    {
                                                        "admin" => "bg-red-100 text-red-800",
                                                        "vagtplanlæggere" => "bg-purple-100 text-purple-800",
                                                        _ => "bg-green-100 text-green-800"
                                                    };
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @badgeColor">
                                                        @group
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-gray-400 italic">Ingen gruppe</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @member.SignupDate.ToString("dd.MM.yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Empty state -->
                <div id="noResults" class="hidden px-6 py-12 text-center">
                    <svg class="mx-auto h-10 w-10 text-gray-300 mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                    <p class="text-sm text-gray-500">Ingen frivillige matcher søgningen.</p>
                </div>

                <!-- Footer with result count -->
                <div class="border-t border-gray-200 px-6 py-3 bg-gray-50">
                    <p class="text-xs text-gray-500">
                        Viser <span id="visibleCount">@Model.Members.Count</span> ud af @Model.Members.Count frivillige
                    </p>
                </div>
            </div>
        </main>

        @await Html.PartialAsync("Partials/_Footer")
    </div>

    <script>
        (function () {
            const searchInput = document.getElementById('searchInput');
            const crewFilter = document.getElementById('crewFilter');
            const groupFilter = document.getElementById('groupFilter');
            const resetBtn = document.getElementById('resetBtn');
            const tableBody = document.getElementById('memberTableBody');
            const noResults = document.getElementById('noResults');
            const memberCountBadge = document.getElementById('memberCount');
            const visibleCount = document.getElementById('visibleCount');

            let rows = Array.from(tableBody.querySelectorAll('tr'));
            let currentSort = { col: 'name', asc: true };

            function applyFiltersAndSort() {
                const search = searchInput.value.toLowerCase().trim();
                const crew = crewFilter.value;
                const group = groupFilter.value;

                let visible = rows.filter(function (row) {
                    const name = row.dataset.name || '';
                    const email = row.dataset.email || '';
                    const crews = row.dataset.crews || '';
                    const hasCrew = row.dataset.hasCrew === '1';
                    const groups = row.dataset.groups || '';
                    const hasGroup = row.dataset.hasGroup === '1';

                    const matchesSearch = !search || name.includes(search) || email.includes(search);

                    let matchesCrew;
                    if (!crew) {
                        matchesCrew = true;
                    } else if (crew === '__none_crew__') {
                        matchesCrew = !hasCrew;
                    } else {
                        matchesCrew = crews.split('|').some(function (c) {
                            return c.trim() === crew.toLowerCase();
                        });
                    }

                    let matchesGroup;
                    if (!group) {
                        matchesGroup = true;
                    } else if (group === '__none_group__') {
                        matchesGroup = !hasGroup;
                    } else {
                        matchesGroup = groups.split('|').some(function (g) {
                            return g.trim() === group.toLowerCase();
                        });
                    }

                    return matchesSearch && matchesCrew && matchesGroup;
                });

                // Sort visible rows
                visible.sort(function (a, b) {
                    if (currentSort.col === 'name') {
                        var valA = a.dataset.name;
                        var valB = b.dataset.name;
                        return currentSort.asc
                            ? valA.localeCompare(valB, 'da')
                            : valB.localeCompare(valA, 'da');
                    } else if (currentSort.col === 'email') {
                        var valA = a.dataset.email;
                        var valB = b.dataset.email;
                        return currentSort.asc
                            ? valA.localeCompare(valB, 'da')
                            : valB.localeCompare(valA, 'da');
                    } else if (currentSort.col === 'signup') {
                        var valA = parseInt(a.dataset.signup, 10);
                        var valB = parseInt(b.dataset.signup, 10);
                        return currentSort.asc ? valA - valB : valB - valA;
                    }
                    return 0;
                });

                // Hide all rows, then append sorted visible rows
                rows.forEach(function (r) { r.style.display = 'none'; });
                visible.forEach(function (r) {
                    r.style.display = '';
                    tableBody.appendChild(r);
                });

                const count = visible.length;
                noResults.classList.toggle('hidden', count > 0);
                visibleCount.textContent = count;
                memberCountBadge.textContent = count + ' frivillige';
            }

            // Column sort headers
            document.querySelectorAll('th[data-sort]').forEach(function (th) {
                th.addEventListener('click', function () {
                    const col = th.dataset.sort;
                    if (currentSort.col === col) {
                        currentSort.asc = !currentSort.asc;
                    } else {
                        currentSort.col = col;
                        currentSort.asc = true;
                    }

                    document.querySelectorAll('th[data-sort]').forEach(function (el) {
                        el.classList.remove('sort-asc', 'sort-desc');
                    });
                    th.classList.add(currentSort.asc ? 'sort-asc' : 'sort-desc');

                    applyFiltersAndSort();
                });
            });

            searchInput.addEventListener('input', applyFiltersAndSort);
            crewFilter.addEventListener('change', applyFiltersAndSort);
            groupFilter.addEventListener('change', applyFiltersAndSort);

            resetBtn.addEventListener('click', function () {
                searchInput.value = '';
                crewFilter.value = '';
                groupFilter.value = '';
                applyFiltersAndSort();
                searchInput.focus();
            });

            // Initial render
            applyFiltersAndSort();
        })();
    </script>
</body>
</html>
