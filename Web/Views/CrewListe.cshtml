@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@using Code.Services
@using Web.ViewModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BbvCrewList>
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject IMemberGroupService MemberGroupService
@inject ICrewService CrewService
@{
    Layout = null;

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    CrewsPageViewModel? viewModel = null;
    string memberName = string.Empty;
    // [CHANGE: crew email export button on crew list] Related: Code/Services/ICrewService.cs, Code/Services/CrewService.cs, Web/Controllers/CrewEmailSurfaceController.cs
    var canExportEmails = false;

    if (currentMember != null)
    {
        // Check if member is in admin group
        var member = MemberService.GetByEmail(currentMember.Email!);
        var isAdmin = false;
        if (member != null)
        {
            var roles = MemberService.GetAllRoles(member.Id);
            var adminGroup = MemberGroupService.GetById(Guid.Parse("99e1edbb-8181-421d-a74b-e66a2f1e1148"));
            isAdmin = adminGroup != null && roles.Contains(adminGroup.Name);

            // Cheap render check: admin or any supervisor/scheduler group.
            // The surface controller re-validates per crew before returning emails.
            var schedulerGroup = MemberGroupService.GetById(Guid.Parse("e6eef645-b13b-4edb-880b-7b3cdf5b6816"));
            canExportEmails = isAdmin
                || (schedulerGroup != null && roles.Contains(schedulerGroup.Name))
                || roles.Contains("Sherif")
                || roles.Contains("Vice sherif");
        }
        var data = await CrewService.GetCrewsForMemberAsync(currentMember.Email!, isAdmin);

        memberName = currentMember.Name ?? currentMember.Email ?? "Bruger";

        viewModel = new CrewsPageViewModel
        {
            MemberName = memberName,
            IsAdmin = isAdmin,
            Crews = data.Crews.Select(c => new CrewListItemViewModel
            {
                Id = c.Id,
                Key = c.Key,
                Name = c.Name,
                Description = c.Description,
                AgeLimit = c.AgeLimit,
                Url = c.Url,
                MaxVoluntiers = c.MaxVoluntiers,
                MemberCount = c.MemberCount,
                WishCount = c.WishCount,
                SupervisorCount = c.SupervisorCount,
                IsMemberAssigned = c.IsMemberAssigned
            }).ToList()
        };
    }
}
<!DOCTYPE html>
<html lang="da" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crews - Blue Bridge - Frivillig</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; }
        h1, h2, h3 { font-family: 'Playfair Display', serif; }
        .bg-blue-bridge { background-color: #23297A; }
        .text-blue-bridge { color: #23297A; }
        .bg-accent-yellow { background-color: #FFF000; }
        .border-blue-bridge { border-color: #23297A; }
    </style>
</head>
<body class="h-full">

@if (currentMember == null)
{
    <!-- Not logged in -->
    <div class="min-h-screen flex items-center justify-center bg-slate-50">
        <div class="text-center">
            <div class="h-12 w-auto bg-blue-bridge flex items-center justify-center text-white font-bold p-2 rounded mx-auto max-w-xs mb-8">
                BLUE BRIDGE <span class="ml-2 font-light text-xs tracking-widest uppercase">Frivillig</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Du skal være logget ind</h2>
            <p class="text-gray-600 mb-6">Log ind for at se dine crews</p>
            <a href="/login" class="inline-block bg-accent-yellow text-blue-bridge px-6 py-3 rounded-md font-bold uppercase tracking-wider hover:opacity-90">
                Log ind
            </a>
        </div>
    </div>
}
else if (viewModel == null)
{
    <!-- Error loading data -->
    <div class="min-h-screen flex items-center justify-center bg-slate-50">
        <div class="text-center">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Der opstod en fejl</h2>
            <p class="text-gray-600 mb-6">Kunne ikke hente crew data. Prøv igen senere.</p>
            <a href="/" class="text-blue-bridge hover:opacity-80 font-semibold">Gå til forsiden</a>
        </div>
    </div>
}
else
{
    @await Html.PartialAsync("Partials/_Navigation")

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <div class="flex flex-wrap items-start gap-3 justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">
                        @if (viewModel.IsAdmin)
                        {
                            <span>Alle Crews</span>
                        }
                        else
                        {
                            <span>Mine Crews</span>
                        }
                    </h1>
                    <p class="mt-2 text-gray-600">
                        @if (viewModel.IsAdmin)
                        {
                            <span>Administrer alle crews og frivillige for Blue Bridge Festival 2026.</span>
                        }
                        else
                        {
                            <span>Se de crews du er tildelt for Blue Bridge Festival 2026.</span>
                        }
                    </p>
                </div>
                @if (viewModel.IsAdmin)
                {
                    <div class="flex items-center space-x-2 bg-amber-50 border border-amber-200 rounded-lg px-4 py-2">
                        <svg class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                        <span class="text-sm font-medium text-amber-800">Administrator visning</span>
                    </div>
                }
            </div>
        </div>

        <!-- Crews List -->
        @if (viewModel.Crews.Any())
        {
            <div class="space-y-3">
                @foreach (var crew in viewModel.Crews.OrderBy(c => c.Name))
                {
                    var pct = (crew.MaxVoluntiers.HasValue && crew.MaxVoluntiers.Value > 0)
                        ? Math.Min(100, (int)Math.Round(crew.MemberCount / (double)crew.MaxVoluntiers.Value * 100))
                        : (int?)null;
                    var pctColor = pct switch
                    {
                        >= 100 => "bg-green-500",
                        >= 75 => "bg-green-400",
                        >= 50 => "bg-amber-400",
                        >= 25 => "bg-amber-300",
                        _ => "bg-red-300"
                    };
                    <a href="@crew.Url" class="block bg-white shadow rounded-lg p-4 hover:bg-gray-50 transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="h-10 w-10 rounded-lg bg-blue-bridge flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                                @(crew.Name.Length > 0 ? crew.Name[0].ToString().ToUpper() : "?")
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="font-medium text-gray-900 truncate">@crew.Name</div>
                                <div class="flex flex-wrap gap-1 mt-0.5">
                                    @if (crew.AgeLimit.HasValue && crew.AgeLimit.Value > 0)
                                    {
                                        <span class="inline-block text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">@crew.AgeLimit+ år</span>
                                    }
                                    @if (!viewModel.IsAdmin && crew.IsMemberAssigned)
                                    {
                                        <span class="inline-block text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded">Tildelt</span>
                                    }
                                </div>
                            </div>
                            @if (canExportEmails && (!viewModel.IsAdmin || crew.MemberCount + crew.SupervisorCount > 0))
                            {
                                <button type="button"
                                        class="export-emails-btn flex items-center gap-1.5 flex-shrink-0 text-xs font-semibold text-blue-bridge bg-gray-100 hover:bg-accent-yellow px-3 py-2 rounded-md transition-colors"
                                        data-crew-id="@crew.Id"
                                        title="Kopiér crewets e-mailadresser">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                    </svg>
                                    <span class="hidden sm:inline">E-mails</span>
                                </button>
                            }
                            <svg class="h-5 w-5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                            </svg>
                        </div>
                        @if (viewModel.IsAdmin)
                        {
                            <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
                                <div class="bg-gray-50 rounded px-3 py-2">
                                    <div class="text-xs text-gray-500 mb-0.5">Frivillige</div>
                                    <span class="text-sm font-semibold @(crew.MemberCount == 0 ? "text-amber-700" : "text-green-700")">
                                        @crew.MemberCount / @(crew.MaxVoluntiers.HasValue ? crew.MaxVoluntiers.Value.ToString() : "-")
                                    </span>
                                </div>
                                <div class="bg-gray-50 rounded px-3 py-2">
                                    <div class="text-xs text-gray-500 mb-1">Fyldt</div>
                                    @if (pct.HasValue)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden">
                                                <div class="@pctColor h-2 rounded-full" style="width: @(pct)%"></div>
                                            </div>
                                            <span class="text-xs font-medium text-gray-600 w-8 text-right">@(pct)%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-gray-400">-</span>
                                    }
                                </div>
                                <div class="bg-gray-50 rounded px-3 py-2">
                                    <div class="text-xs text-gray-500 mb-0.5">Ansøgere</div>
                                    <span class="text-sm font-semibold @(crew.WishCount > 0 ? "text-blue-700" : "text-gray-500")">@crew.WishCount</span>
                                </div>
                                <div class="bg-gray-50 rounded px-3 py-2">
                                    <div class="text-xs text-gray-500 mb-0.5">Sherif / vice</div>
                                    <span class="text-sm font-semibold @(crew.SupervisorCount > 0 ? "text-purple-700" : "text-gray-500")">@crew.SupervisorCount</span>
                                </div>
                            </div>
                        }
                    </a>
                }
            </div>
        }
        else
        {
            <!-- No crews -->
            <div class="bg-white shadow rounded-lg p-12 text-center">
                <svg class="mx-auto h-16 w-16 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                </svg>
                <h3 class="mt-6 text-xl font-semibold text-gray-900">Ingen crews endnu</h3>
                @if (viewModel.IsAdmin)
                {
                    <p class="mt-2 text-gray-600">Der er ingen crews oprettet i systemet endnu.</p>
                    <a href="/umbraco" class="mt-4 inline-block text-blue-bridge hover:opacity-80 font-semibold">
                        Opret crews i Umbraco &rarr;
                    </a>
                }
                else
                {
                    <p class="mt-2 text-gray-600">Du er ikke blevet tildelt et crew endnu. Vi vender tilbage snarest.</p>
                    <a href="/dashboard" class="mt-4 inline-block text-blue-bridge hover:opacity-80 font-semibold">
                        Tilbage til Min Side &rarr;
                    </a>
                }
            </div>
        }
    </main>

    @if (canExportEmails)
    {
        <!-- Email export dialog (same pattern as ShiftList's "Kopiér til e-mail") -->
        <dialog id="emailDialog" class="rounded-lg shadow-xl w-full max-w-2xl p-0 backdrop:bg-black/50">
            <div class="bg-blue-bridge px-6 py-4 flex items-center justify-between">
                <h3 id="emailDialogTitle" class="text-lg font-bold text-white">E-mails</h3>
                <button type="button" id="closeEmailDialog" class="text-white/80 hover:text-white text-2xl leading-none" aria-label="Luk">&times;</button>
            </div>
            <div class="p-6">
                <p id="emailDialogCount" class="text-sm text-gray-600 mb-3"></p>
                <textarea id="emailText" readonly rows="8"
                          class="w-full border border-gray-300 rounded-md p-3 font-mono text-sm text-gray-900 bg-slate-50"></textarea>
                <div class="mt-4 flex items-center gap-3">
                    <button type="button" id="copyEmailText"
                            class="bg-accent-yellow text-blue-bridge px-5 py-2.5 rounded-md font-bold uppercase tracking-wider text-sm hover:opacity-90">
                        Kopiér
                    </button>
                    <span id="copyFeedback" class="hidden text-sm font-semibold text-green-700">Kopieret!</span>
                </div>
            </div>
        </dialog>

        <script>
            (function () {
                const dialog = document.getElementById('emailDialog');
                const title = document.getElementById('emailDialogTitle');
                const count = document.getElementById('emailDialogCount');
                const textarea = document.getElementById('emailText');
                const copyBtn = document.getElementById('copyEmailText');
                const feedback = document.getElementById('copyFeedback');

                document.getElementById('closeEmailDialog').addEventListener('click', () => dialog.close());

                document.querySelectorAll('.export-emails-btn').forEach(btn => {
                    btn.addEventListener('click', async (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        btn.disabled = true;
                        try {
                            const res = await fetch('/umbraco/surface/CrewEmailSurface/GetEmails?crewId=' + btn.dataset.crewId);
                            if (!res.ok) { throw new Error('HTTP ' + res.status); }
                            const data = await res.json();
                            title.textContent = data.crewName;
                            count.textContent = data.emails.length === 1
                                ? '1 e-mailadresse'
                                : data.emails.length + ' e-mailadresser';
                            textarea.value = data.emails.join('; ');
                            copyBtn.disabled = data.emails.length === 0;
                            if (data.emails.length === 0) {
                                textarea.value = '';
                                textarea.placeholder = 'Ingen e-mails fundet.';
                            }
                        } catch (err) {
                            title.textContent = 'Fejl';
                            count.textContent = 'Kunne ikke hente e-mails. Prøv igen.';
                            textarea.value = '';
                            copyBtn.disabled = true;
                        }
                        feedback.classList.add('hidden');
                        dialog.showModal();
                        btn.disabled = false;
                    });
                });

                copyBtn.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(textarea.value);
                    } catch {
                        // Clipboard API needs a secure context — fall back to selecting the text
                        textarea.select();
                        document.execCommand('copy');
                    }
                    feedback.classList.remove('hidden');
                });
            })();
        </script>
    }

    @await Html.PartialAsync("Partials/_Footer")
}

</body>
</html>
