@{
    @* [CHANGE: crew invitation feature] Related: Web/Controllers/CrewInvitationSurfaceController.cs, Web/Views/AcceptCrewInvitation.cshtml *@
    Layout = null;
    var memberName = TempData["MemberName"] as string ?? "Frivillig";
    var crewName = TempData["CrewName"] as string;
}
<!DOCTYPE html>
<html lang="da" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velkommen som frivillig - Blue Bridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; }
        h1, h2, h3 { font-family: 'Playfair Display', serif; }
        .bg-blue-bridge { background-color: #23297A; }
        .text-blue-bridge { color: #23297A; }
        .bg-accent-yellow { background-color: #FFF000; }
    </style>
</head>
<body class="h-full">

<div class="min-h-full flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full">
        <div class="text-center mb-8">
            <div class="h-12 w-auto bg-blue-bridge flex items-center justify-center text-white font-bold p-2 rounded mx-auto max-w-xs">
                BLUE BRIDGE <span class="ml-2 font-light text-xs tracking-widest uppercase">Frivillig</span>
            </div>
        </div>

        <div class="bg-white py-10 px-6 shadow sm:rounded-lg text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100 mb-6">
                <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
            </div>
            <h2 class="text-3xl font-bold text-gray-900">Velkommen, @memberName!</h2>
            @if (!string.IsNullOrEmpty(crewName))
            {
                <p class="mt-4 text-gray-600">
                    Du er nu tilmeldt som frivillig i <strong>@crewName</strong>.
                </p>
            }
            <p class="mt-2 text-gray-600">
                Du er logget ind og kan se dine oplysninger og vagter på din side.
            </p>
            <a href="/frivillig/forside/"
               class="mt-8 inline-flex justify-center rounded-md bg-accent-yellow px-6 py-3 text-sm font-bold text-blue-bridge shadow-sm hover:opacity-90 uppercase tracking-wider">
                Gå til min side
            </a>
        </div>
    </div>
</div>

</body>
</html>
