@using Umbraco.Cms.Web.Common.PublishedModels
@inject Umbraco.Cms.Core.IPublishedContentQuery PublishedContentQuery
@{
    var siteSettings = PublishedContentQuery.ContentAtRoot()
        .FirstOrDefault(x => x.ContentType.Alias == "bbvSiteSettings") as BbvSiteSettings;

    var copyrightText = siteSettings?.CopyrightText;
    var footerNav = siteSettings?.FooterNavigation?.ToList();
}
<footer class="bg-slate-100 border-t border-slate-200 mt-12">
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="text-sm text-gray-500">
                @if (!string.IsNullOrEmpty(copyrightText))
                {
                    @copyrightText
                }
                else
                {
                    <span>&copy; @DateTime.Now.Year Blue Bridge Festival. Alle rettigheder forbeholdes.</span>
                }
            </div>
            @if (footerNav != null && footerNav.Any())
            {
                <div class="mt-4 md:mt-0 flex space-x-6">
                    @foreach (var link in footerNav)
                    {
                        <a href="@link.Url()" class="text-sm text-gray-500 hover:text-gray-900">@link.Name</a>
                    }
                </div>
            }
        </div>
    </div>
</footer>
